# Port the server listens on
PORT=3000

# Public base URL of your deployment (no trailing slash)
# Used to build the shareable /send/<id> links
BASE_URL=http://localhost:3000

# 32-byte (64 hex chars) key used to encrypt bot tokens at rest.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_a_64_character_hex_string
